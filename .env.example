# Postgres connection string.
# Local dev:  postgresql://postgres:postgres@localhost:5432/postgres
# Supabase:   Dashboard → Connect → use the TRANSACTION POOLER string for the
#             deployed app; the SESSION/DIRECT string works best for db:push.
DATABASE_URL=

# Vercel AI Gateway key — covers Claude models AND embeddings
AI_GATEWAY_API_KEY=

# pino level: debug | info | warn | error
LOG_LEVEL=info
